{
  "name": "@libai168/dsh-tool-shopify",
  "description": "Read-only Shopify Admin GraphQL tools for stores, products, orders, customers, inventory, and collections",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "shopify",
    "ecommerce",
    "admin-api",
    "graphql",
    "read-only"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LJH-snow/dsh-tool-shopify.git"
  },
  "homepage": "https://github.com/LJH-snow/dsh-tool-shopify#readme"
}
